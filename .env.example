# Agents — cleanup, style guide, scenarios, scene HTML, copy.
# Anthropic models reached through the OpenRouter gateway, so one key covers all
# five. Model ids live in src/mastra/models.ts.
OPENROUTER_API_KEY=

# Transcription only.
#
# This is a second key on purpose. The pipeline is built on word-level
# timestamps (idea.md §3), and chat-completions gateways don't carry them — so
# this one call goes to AssemblyAI directly, on `universal-3-5-pro`.
ASSEMBLYAI_API_KEY=
