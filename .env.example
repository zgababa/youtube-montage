# Agents — cleanup, style guide, scenarios, scene HTML, copy.
# Anthropic models reached through the OpenRouter gateway, so one key covers all
# four. Model ids live in src/mastra/models.ts.
OPENROUTER_API_KEY=

# Transcription only.
#
# This is a second key on purpose. The pipeline is built on word-level
# timestamps (idea.md §3), and `whisper-1` with
# `timestamp_granularities: ["word"]` is the only way to get them — the
# gpt-4o-transcribe family dropped granular timestamps, and gateways don't
# expose the parameter. So this one call goes to OpenAI directly.
OPENAI_API_KEY=
